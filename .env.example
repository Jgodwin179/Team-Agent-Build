# --- Next.js / Vercel (public) ---
NEXT_PUBLIC_CONVEX_URL=
NEXT_PUBLIC_CONVEX_SITE_URL=
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Convex CLI (local) ---
CONVEX_DEPLOYMENT=
# Optional: isolated cloud agent deploy key (never commit real values)
CONVEX_DEPLOY_KEY=

# --- Outbound safety (default: dry-run / mock) ---
# Set to "true" only with explicit authorization for live sends
ALLOW_LIVE_OUTBOUND=

# --- Chat SDK (Phase 4; Redis is production state) ---
REDIS_URL=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_AUTH_TOKEN_OPTIONAL=
# Adapter-specific vars — confirm names against @chat-adapter/twilio docs

# --- Email (Phase 4) ---
AGENTMAIL_API_KEY=

# --- Connectors (Phase 3) ---
COMPOSIO_API_KEY=
# Provider OAuth is managed; store references, not raw tokens, in app data

# --- CRM (Phase 3/4) ---
GHL_API_KEY=
GHL_LOCATION_ID=

# NOTE: BETTER_AUTH_SECRET and SITE_URL are set on the Convex deployment:
#   npx convex env set BETTER_AUTH_SECRET=...
#   npx convex env set SITE_URL=http://localhost:3000
# AI Gateway credentials for Convex actions are also Convex-side env vars.
# See docs/convex-env-setup.md
