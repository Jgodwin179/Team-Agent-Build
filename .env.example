# --- Next.js / Vercel (public) ---
NEXT_PUBLIC_CONVEX_URL=
NEXT_PUBLIC_CONVEX_SITE_URL=
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Convex CLI (local) ---
CONVEX_DEPLOYMENT=
# Optional: isolated cloud agent deploy key (never commit real values)
CONVEX_DEPLOY_KEY=

# --- Outbound safety (default: dry-run / mock) ---
# Set to "true" only with explicit authorization for live sends
ALLOW_LIVE_OUTBOUND=

# --- Chat SDK (Phase 4; Redis is production state) ---
# Production: Upstash / Redis Cloud URL for @chat-adapter/state-redis
REDIS_URL=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
TWILIO_MESSAGING_SERVICE_SID=
# Public URL Twilio posts to (must match signature base)
TWILIO_WEBHOOK_URL=http://localhost:3000/api/webhooks/twilio

# --- Email (Phase 4) — AgentMail behind EmailProvider ---
AGENTMAIL_API_KEY=
AGENTMAIL_WEBHOOK_SECRET=
# Local webhook fixtures only when secret unset: header X-AgentMail-Mock: true

# --- Connectors (Phase 3) — also set on Convex deployment ---
COMPOSIO_API_KEY=
# Provider OAuth is managed; store connected-account refs in app data, not raw tokens

# --- CRM (Phase 3/4) — also set on Convex deployment ---
GHL_API_KEY=
GHL_LOCATION_ID=
# Force labeled MOCK even when GHL keys exist
GHL_FORCE_MOCK=
# Keep unset/false — Phase 3 never performs live CRM writes
ALLOW_LIVE_CRM_WRITES=

# NOTE: BETTER_AUTH_SECRET and SITE_URL are set on the Convex deployment:
#   npx convex env set BETTER_AUTH_SECRET=...
#   npx convex env set SITE_URL=http://localhost:3000
# Optional Phase 2+: enable live gateway models ONLY when Convex AI Gateway is configured:
#   npx convex env set USE_AI_GATEWAY true
# Default is mockModel (clearly labeled). AI Gateway credentials are Convex-side.
# See docs/convex-env-setup.md
